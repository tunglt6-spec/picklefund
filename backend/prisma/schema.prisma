generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CLUBS (Multi-tenant root)
// ============================================================
model Club {
  id            String      @id @default(uuid())
  name          String      @db.VarChar(200)
  code          String      @unique @db.VarChar(20)
  logoUrl       String?     @map("logo_url")
  address       String?
  contactEmail  String?     @map("contact_email") @db.VarChar(255)
  contactPhone  String?     @map("contact_phone") @db.VarChar(20)
  status        ClubStatus  @default(active)
  plan          ServicePlan @default(STARTER)
  planExpiresAt DateTime?   @map("plan_expires_at")
  settings      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  users                User[]
  members              Member[]
  fundPeriods          FundPeriod[]
  attendanceSessions   AttendanceSession[]
  attendanceRecords    AttendanceRecord[]
  contributions        FundContribution[]
  expenses             LivingExpense[]
  expenseCategories    ExpenseCategory[]
  personalReceipts     PersonalReceipt[]
  auditLogs            AuditLog[]
  minigames            Minigame[]
  payments             Payment[]
  aiActions            AiAction[]
  workflowRules        WorkflowRule[]
  workflowRuns         WorkflowRun[]
  notificationJobs     NotificationJob[]
  sessionRegistrations SessionRegistration[]
  fundPeriodMembers    FundPeriodMember[]
  clubMemories         ClubMemory[]
  scoringRules         ScoringRule[]
  memberScoreEvents    MemberScoreEvent[]
  memberScoreSnapshots MemberScoreSnapshot[]
  maikaInsights        MaikaInsight[]
  lisaMessages         LisaMessage[]

  @@map("clubs")
}

enum ClubStatus {
  active
  suspended
  deleted
}

/// Gói dịch vụ SaaS (V2.2). STARTER giới hạn thành viên; PRO/CLUB_PLUS không giới hạn.
enum ServicePlan {
  STARTER
  PRO
  CLUB_PLUS
}

// ============================================================
// USERS (Auth accounts)
// ============================================================
model User {
  id           String   @id @default(uuid())
  clubId       String?  @map("club_id")
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         Role     @default(MEMBER_VIEW)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  club                 Club?                   @relation(fields: [clubId], references: [id])
  member               Member?
  auditLogs            AuditLog[]
  createdFundPeriods   FundPeriod[]            @relation("FundPeriodCreatedBy")
  createdSessions      AttendanceSession[]     @relation("SessionCreatedBy")
  createdContributions FundContribution[]      @relation("ContributionCreatedBy")
  createdExpenses      LivingExpense[]         @relation("ExpenseCreatedBy")
  refreshTokens        RefreshToken[]
  apiKeys              ApiKey[]
  totpSecret           String?                 @map("totp_secret")
  totpEnabled          Boolean                 @default(false) @map("totp_enabled")
  mustChangePassword   Boolean                 @default(false) @map("must_change_password")
  lastLoginAt          DateTime?               @map("last_login_at")
  notificationEnabled  Boolean                 @default(true) @map("notification_enabled")
  notifications        Notification[]
  notificationPref     NotificationPreference?
  confirmedPayments    Payment[]               @relation("PaymentConfirmedBy")

  @@index([clubId])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  CLUB_ADMIN
  CLUB_TREASURER
  MEMBER_VIEW
}

// ============================================================
// MEMBERS (Club member profiles)
// ============================================================
model Member {
  id        String       @id @default(uuid())
  clubId    String       @map("club_id")
  userId    String?      @unique @map("user_id")
  fullName  String       @map("full_name") @db.VarChar(200)
  phone     String?      @db.VarChar(20)
  email     String?      @db.VarChar(255)
  joinDate  DateTime     @map("join_date") @db.Date
  status    MemberStatus @default(active)
  avatarUrl  String?      @map("avatar_url")
  notes      String?
  skillLevel Int?         @map("skill_level")
  isDeleted  Boolean      @default(false) @map("is_deleted")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  club                  Club                  @relation(fields: [clubId], references: [id])
  user                  User?                 @relation(fields: [userId], references: [id])
  contributions         FundContribution[]
  attendanceRecords     AttendanceRecord[]
  personalReceipts      PersonalReceipt[]
  minigames             MinigameParticipant[]
  teamsAsPlayer1        MinigameTeam[]        @relation("TeamPlayer1")
  teamsAsPlayer2        MinigameTeam[]        @relation("TeamPlayer2")
  payments              Payment[]
  sessionRegistrations  SessionRegistration[]
  fundPeriodMemberships FundPeriodMember[]
  scoreEvents           MemberScoreEvent[]
  scoreSnapshots        MemberScoreSnapshot[]

  @@index([clubId, isDeleted])
  @@map("members")
}

enum MemberStatus {
  active
  inactive
  left
}

// ============================================================
// FUND PERIODS (Quarterly cycles)
// ============================================================
model FundPeriod {
  id                 String           @id @default(uuid())
  clubId             String           @map("club_id")
  name               String           @db.VarChar(100)
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  contributionAmount Decimal          @map("contribution_amount") @db.Decimal(15, 2)
  totalSessions      Int              @default(0) @map("total_sessions")
  status             FundPeriodStatus @default(draft)
  type               String           @default("chung") @map("type")
  notes              String?
  finalizedAt        DateTime?        @map("finalized_at")
  /// Sĩ số tính phí ĐÃ CHỐT của kỳ (chia phí sân/người = tổng ÷ số này). null = dùng số
  /// thành viên live (chỉ kỳ đang thu mới nhất). Kỳ khác chốt cứng → xóa/thêm member KHÔNG
  /// làm lệch bill lịch sử. Xem members.service.remove + fund-periods snapshotPastPeriods.
  billedMemberCount  Int?             @map("billed_member_count")
  /// Cache số dư cuối kỳ (clubAssets.balance) lưu lúc finalize → summary kỳ sau đọc thẳng,
  /// bỏ đệ quy carryForward. CHỈ dùng khi != null; XÓA (=null) khi có bất kỳ ghi thu/chi nào
  /// của CLB (invalidateClosingBalances) ⇒ không bao giờ stale. Xem fund-periods.summary().
  closingBalance     Decimal?         @map("closing_balance") @db.Decimal(15, 2)
  createdById        String           @map("created_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  club               Club                @relation(fields: [clubId], references: [id])
  createdBy          User                @relation("FundPeriodCreatedBy", fields: [createdById], references: [id])
  contributions      FundContribution[]
  attendanceSessions AttendanceSession[]
  expenses           LivingExpense[]
  personalReceipts   PersonalReceipt[]
  periodMembers      FundPeriodMember[]

  @@index([clubId])
  @@index([clubId, type, status], map: "idx_fp_club_type_status")
  @@index([clubId, startDate], map: "idx_fp_club_start")
  @@map("fund_periods")
}

/// Roster thành viên "được kỳ vọng đóng" của 1 kỳ quỹ (chủ yếu Quỹ Phụ/giải đấu —
/// không phải mọi thành viên CLB đều tham gia mỗi giải). TÁCH BIỆT FundContribution
/// (log giao dịch thực tế) — roster tồn tại kể cả khi chưa có giao dịch nào, dùng để
/// biết "ai thuộc kỳ này + mức đóng kỳ vọng"; trạng thái đã đóng/chưa đóng luôn SUY RA
/// từ FundContribution (không lưu paidAmount/status ở đây để tránh dữ liệu trùng/lệch).
model FundPeriodMember {
  id             String   @id @default(uuid())
  clubId         String   @map("club_id")
  fundPeriodId   String   @map("fund_period_id")
  memberId       String   @map("member_id")
  expectedAmount Decimal  @map("expected_amount") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  club       Club       @relation(fields: [clubId], references: [id])
  fundPeriod FundPeriod @relation(fields: [fundPeriodId], references: [id], onDelete: Cascade)
  member     Member     @relation(fields: [memberId], references: [id])

  @@unique([fundPeriodId, memberId])
  @@index([clubId, fundPeriodId])
  @@map("fund_period_members")
}

enum FundPeriodStatus {
  draft
  active
  closed
  finalized
}

// ============================================================
// ATTENDANCE SESSIONS (Each play session)
// ============================================================
model AttendanceSession {
  id           String        @id @default(uuid())
  clubId       String        @map("club_id")
  fundPeriodId String        @map("fund_period_id")
  sessionDate  DateTime      @map("session_date") @db.Date
  startTime    String?       @map("start_time") @db.VarChar(5)
  endTime      String?       @map("end_time") @db.VarChar(5)
  courtFee     Decimal       @default(0) @map("court_fee") @db.Decimal(15, 2)
  courtName    String?       @map("court_name") @db.VarChar(200)
  status       SessionStatus @default(scheduled)
  notes        String?
  createdById  String        @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  club              Club                  @relation(fields: [clubId], references: [id])
  fundPeriod        FundPeriod            @relation(fields: [fundPeriodId], references: [id])
  createdBy         User                  @relation("SessionCreatedBy", fields: [createdById], references: [id])
  attendanceRecords AttendanceRecord[]
  registrations     SessionRegistration[]
  expenses          LivingExpense[]

  @@index([clubId, fundPeriodId])
  @@index([clubId, sessionDate], map: "idx_as_club_session_date")
  @@map("attendance_sessions")
}

/// RSVP — thành viên đăng ký tham gia buổi chơi (trước khi diễn ra / check-in).
/// TÁCH BIỆT với AttendanceRecord (điểm danh thực tế PRESENT/ABSENT dùng tính quỹ) —
/// đăng ký KHÔNG ảnh hưởng tính Common Fund / Mini Fund.
model SessionRegistration {
  id                  String   @id @default(uuid())
  clubId              String   @map("club_id")
  attendanceSessionId String   @map("attendance_session_id")
  memberId            String   @map("member_id")
  createdAt           DateTime @default(now()) @map("created_at")

  club              Club              @relation(fields: [clubId], references: [id])
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  member            Member            @relation(fields: [memberId], references: [id])

  @@unique([attendanceSessionId, memberId])
  @@index([clubId, attendanceSessionId])
  @@map("session_registrations")
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

// ============================================================
// ATTENDANCE RECORDS (Per-member attendance)
// ============================================================
model AttendanceRecord {
  id                  String           @id @default(uuid())
  clubId              String           @map("club_id")
  attendanceSessionId String           @map("attendance_session_id")
  memberId            String           @map("member_id")
  status              AttendanceStatus @default(ABSENT)
  createdAt           DateTime         @default(now()) @map("created_at")

  club              Club              @relation(fields: [clubId], references: [id])
  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  member            Member            @relation(fields: [memberId], references: [id])

  @@unique([attendanceSessionId, memberId])
  @@index([memberId, status])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ============================================================
// FUND CONTRIBUTIONS (Member payments)
// ============================================================
model FundContribution {
  id                String          @id @default(uuid())
  clubId            String          @map("club_id")
  fundPeriodId      String?         @map("fund_period_id")
  memberId          String?         @map("member_id")
  fundSource        FundSource      @default(COMMON) @map("fund_source")
  miniIncomeType    MiniIncomeType? @map("mini_income_type")
  payerName         String?         @map("payer_name") @db.VarChar(200)
  relatedMinigameId String?         @map("related_minigame_id")
  amount            Decimal         @db.Decimal(15, 2)
  paymentDate       DateTime        @map("payment_date") @db.Date
  paymentMethod     String          @default("bank_transfer") @map("payment_method") @db.VarChar(50)
  isConfirmed       Boolean         @default(false) @map("is_confirmed")
  notes             String?
  createdById       String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  club            Club        @relation(fields: [clubId], references: [id])
  fundPeriod      FundPeriod? @relation(fields: [fundPeriodId], references: [id])
  member          Member?     @relation(fields: [memberId], references: [id])
  relatedMinigame Minigame?   @relation("ContributionMinigame", fields: [relatedMinigameId], references: [id])
  createdBy       User        @relation("ContributionCreatedBy", fields: [createdById], references: [id])

  @@index([clubId, fundPeriodId])
  @@index([clubId, memberId])
  @@index([clubId, isConfirmed])
  @@index([clubId, fundSource, isConfirmed], map: "idx_fc_club_fundsrc_confirmed")
  @@map("fund_contributions")
}

enum FundSource {
  COMMON
  MINI
}

enum MiniIncomeType {
  BETTING
  SPONSORSHIP
  PENALTY
  DONATION
  OTHER
}

enum MiniExpenseType {
  GAME_REWARD
  TOURNAMENT_PRIZE
  PARTY
  BALL_PURCHASE
  OTHER
}

// ============================================================
// EXPENSE CATEGORIES
// ============================================================
model ExpenseCategory {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  name      String   @db.VarChar(100)
  icon      String?  @db.VarChar(10)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  club     Club            @relation(fields: [clubId], references: [id])
  expenses LivingExpense[]

  @@index([clubId])
  @@map("expense_categories")
}

// ============================================================
// LIVING EXPENSES (Chi phí sinh hoạt)
// ============================================================
model LivingExpense {
  id                  String           @id @default(uuid())
  clubId              String           @map("club_id")
  fundPeriodId        String?          @map("fund_period_id")
  attendanceSessionId String?          @map("attendance_session_id")
  categoryId          String?          @map("category_id")
  fundSource          FundSource       @default(COMMON) @map("fund_source")
  miniExpenseType     MiniExpenseType? @map("mini_expense_type")
  receiverName        String?          @map("receiver_name") @db.VarChar(200)
  relatedMinigameId   String?          @map("related_minigame_id")
  allocationEnabled   Boolean          @default(true) @map("allocation_enabled")
  status              String           @default("pending")
  amount              Decimal          @db.Decimal(15, 2)
  description         String
  allocationRule      AllocationRule   @default(FUND_ONLY) @map("allocation_rule")
  costType            CostType         @default(LIVING) @map("cost_type")
  expenseDate         DateTime         @map("expense_date") @db.Date
  receiptUrl          String?          @map("receipt_url")
  createdById         String           @map("created_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  club              Club               @relation(fields: [clubId], references: [id])
  fundPeriod        FundPeriod?        @relation(fields: [fundPeriodId], references: [id])
  attendanceSession AttendanceSession? @relation(fields: [attendanceSessionId], references: [id])
  category          ExpenseCategory?   @relation(fields: [categoryId], references: [id])
  relatedMinigame   Minigame?          @relation("ExpenseMinigame", fields: [relatedMinigameId], references: [id])
  createdBy         User               @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([clubId, fundPeriodId])
  @@index([clubId, fundSource, status], map: "idx_le_club_fundsrc_status")
  @@index([attendanceSessionId], map: "idx_le_att_session")
  @@index([clubId, expenseDate], map: "idx_le_club_expdate")
  @@map("living_expenses")
}

enum AllocationRule {
  ATTENDANCE
  EQUAL
  PRESENT_ONLY
  FUND_ONLY
}

/// Loại chi phí (luật Quỹ): COURT = tiền thuê sân (LUÔN chia đều);
/// LIVING = sinh hoạt (nước/ăn uống/bóng...) — chia đều HOẶC theo người tham gia tùy khoản.
/// Tách "loại chi" khỏi "cách chia" (allocationRule) — trước đây suy loại từ rule nên
/// sinh hoạt chia đều bị gộp nhầm vào cột chi phí sân.
enum CostType {
  COURT
  LIVING
}

// ============================================================
// PERSONAL RECEIPTS (Snapshot per member per period)
// ============================================================
model PersonalReceipt {
  id               String   @id @default(uuid())
  clubId           String   @map("club_id")
  fundPeriodId     String   @map("fund_period_id")
  memberId         String   @map("member_id")
  totalSessions    Int      @map("total_sessions")
  attendedSessions Int      @map("attended_sessions")
  attendanceRate   Decimal  @map("attendance_rate") @db.Decimal(5, 2)
  amountPaid       Decimal  @map("amount_paid") @db.Decimal(15, 2)
  courtCost        Decimal  @map("court_cost") @db.Decimal(15, 2)
  livingCost       Decimal  @map("living_cost") @db.Decimal(15, 2)
  totalCost        Decimal  @map("total_cost") @db.Decimal(15, 2)
  balance          Decimal  @db.Decimal(15, 2)
  needToPay        Decimal  @default(0) @map("need_to_pay") @db.Decimal(15, 2)
  snapshotAt       DateTime @default(now()) @map("snapshot_at")

  club       Club       @relation(fields: [clubId], references: [id])
  fundPeriod FundPeriod @relation(fields: [fundPeriodId], references: [id])
  member     Member     @relation(fields: [memberId], references: [id])

  @@unique([fundPeriodId, memberId])
  @@index([clubId, fundPeriodId])
  @@map("personal_receipts")
}

// ============================================================
// AUDIT LOGS
// ============================================================
model AuditLog {
  id         String   @id @default(uuid())
  clubId     String?  @map("club_id")
  userId     String   @map("user_id")
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id")
  detail     String?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  club Club? @relation(fields: [clubId], references: [id])
  user User  @relation(fields: [userId], references: [id])

  @@index([clubId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================================
// NOTIFICATIONS (Hermes — Communication Orchestrator)
// ============================================================
model Notification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  clubId    String               @map("club_id")
  eventType String               @map("event_type") @db.VarChar(50)
  priority  NotificationPriority @default(MEDIUM)
  channel   NotificationChannel  @default(IN_APP)
  title     String               @db.VarChar(200)
  body      String
  metadata  Json?
  status    NotificationStatus   @default(PENDING)
  sentAt    DateTime?            @map("sent_at")
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([clubId, eventType])
  @@map("notifications")
}

model NotificationPreference {
  id               String                @id @default(uuid())
  userId           String                @unique @map("user_id")
  // Multi-channel: các kênh user chọn nhận thông báo (bật đồng thời nhiều kênh).
  // Nguồn chân lý mới. `preferredChannel` giữ lại để backward-compat (đồng bộ = channels[0]).
  channels         NotificationChannel[] @default([IN_APP])
  preferredChannel NotificationChannel   @default(IN_APP) @map("preferred_channel")
  telegramChatId   String?               @map("telegram_chat_id") @db.VarChar(50)
  quietHoursStart  Int                   @default(23) @map("quiet_hours_start")
  quietHoursEnd    Int                   @default(7) @map("quiet_hours_end")
  maxDailyPush     Int                   @default(3) @map("max_daily_push")
  maxDailyEmail    Int                   @default(1) @map("max_daily_email")
  maxDailyTelegram Int                   @default(5) @map("max_daily_telegram")
  enabled          Boolean               @default(true)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum NotificationPriority {
  HIGH
  MEDIUM
  LOW
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

// ============================================================
// REFRESH TOKENS
// ============================================================
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================
// MINIGAME (Tournament management)
// ============================================================
model Minigame {
  id          String         @id @default(uuid())
  clubId      String         @map("club_id")
  name        String         @db.VarChar(200)
  format      MinigameFormat
  status      MinigameStatus @default(DRAFT)
  settings    Json?
  scheduledAt DateTime?      @map("scheduled_at")
  startedAt   DateTime?      @map("started_at")
  endedAt     DateTime?      @map("ended_at")
  createdById String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  club              Club                  @relation(fields: [clubId], references: [id])
  teams             MinigameTeam[]
  matches           MinigameMatch[]
  participants      MinigameParticipant[]
  miniContributions FundContribution[]    @relation("ContributionMinigame")
  miniExpenses      LivingExpense[]       @relation("ExpenseMinigame")

  @@index([clubId])
  @@map("minigames")
}

enum MinigameFormat {
  RANDOM_DOUBLES
  FIXED_DOUBLES_ROUND_ROBIN
  GROUP_STAGE
  KNOCKOUT
  SINGLES
}

enum MinigameStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model MinigameParticipant {
  id         String   @id @default(uuid())
  minigameId String   @map("minigame_id")
  memberId   String   @map("member_id")
  createdAt  DateTime @default(now()) @map("created_at")

  minigame Minigame @relation(fields: [minigameId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])

  @@unique([minigameId, memberId])
  @@map("minigame_participants")
}

model MinigameTeam {
  id         String   @id @default(uuid())
  minigameId String   @map("minigame_id")
  name       String   @db.VarChar(100)
  // Mỗi slot là MEMBER (playerNId FK) HOẶC KHÁCH (playerNGuestId + playerNName denormalized).
  player1Id      String? @map("player1_id")
  player1GuestId String? @map("player1_guest_id")
  player1Name    String? @map("player1_name")
  player2Id      String? @map("player2_id")
  player2GuestId String? @map("player2_guest_id")
  player2Name    String? @map("player2_name")
  round      Int?
  wins       Int      @default(0)
  losses     Int      @default(0)
  points     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  minigame   Minigame        @relation(fields: [minigameId], references: [id], onDelete: Cascade)
  player1    Member?         @relation("TeamPlayer1", fields: [player1Id], references: [id])
  player2    Member?         @relation("TeamPlayer2", fields: [player2Id], references: [id])
  matchesAsA MinigameMatch[] @relation("MatchTeamA")
  matchesAsB MinigameMatch[] @relation("MatchTeamB")

  @@index([minigameId], map: "idx_mt_minigame")
  @@map("minigame_teams")
}

model MinigameMatch {
  id         String      @id @default(uuid())
  minigameId String      @map("minigame_id")
  teamAId    String?     @map("team_a_id")
  teamBId    String?     @map("team_b_id")
  // GROUP_STAGE: tag bảng (Minigame.settings.groups[].id). Null với các format khác.
  groupId    String?     @map("group_id")
  scoreA     Int?        @map("score_a")
  scoreB     Int?        @map("score_b")
  winnerId   String?     @map("winner_id")
  round      Int         @default(1)
  /// Lượt đấu: 1 = lượt đi, 2 = lượt về (double round-robin). round đánh lại 1..N mỗi lượt.
  leg        Int         @default(1)
  courtNo    Int?        @map("court_no")
  status     MatchStatus @default(PENDING)
  playedAt   DateTime?   @map("played_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  minigame Minigame      @relation(fields: [minigameId], references: [id], onDelete: Cascade)
  teamA    MinigameTeam? @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB    MinigameTeam? @relation("MatchTeamB", fields: [teamBId], references: [id])

  @@index([minigameId, status], map: "idx_mm_minigame_status")
  @@map("minigame_matches")
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// API KEYS (Long-lived keys for service accounts / AI agents)
// ============================================================
model ApiKey {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  keyHash     String    @unique @map("key_hash") @db.VarChar(255)
  keyPrefix   String    @map("key_prefix") @db.VarChar(12)
  createdById String    @map("created_by")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}

// ============================================================
// PAYMENTS (QR Payment — Sprint 01)
// ============================================================
model Payment {
  id            String         @id @default(uuid())
  clubId        String         @map("club_id")
  memberId      String         @map("member_id")
  amount        Decimal        @db.Decimal(15, 2)
  description   String         @db.VarChar(500)
  referenceType PaymentRefType @map("reference_type")
  referenceId   String?        @map("reference_id")
  bankCode      String         @default("MB") @map("bank_code") @db.VarChar(10)
  accountNumber String         @map("account_number") @db.VarChar(30)
  accountName   String         @map("account_name") @db.VarChar(100)
  qrImageUrl    String?        @map("qr_image_url")
  status        PaymentStatus  @default(PENDING)
  confirmedById String?        @map("confirmed_by")
  confirmedAt   DateTime?      @map("confirmed_at")
  expiredAt     DateTime?      @map("expired_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  club        Club   @relation(fields: [clubId], references: [id])
  member      Member @relation(fields: [memberId], references: [id])
  confirmedBy User?  @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])

  @@index([clubId, status])
  @@index([memberId])
  @@map("payments")
}

enum PaymentRefType {
  CONTRIBUTION
  EXPENSE
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

// ============================================================
// SYSTEM SETTINGS (key-value store for SUPER_ADMIN config)
// ============================================================
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================
// AI ACTION QUEUE (Epic 4.2) — persisted AI actions + approval + per-action audit trail
// ============================================================
enum AiAgent {
  MAIKA
  LISA
  HERMES
  MIT_DAT
}

enum AiActionRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  RETRY_PENDING
  EXPIRED
}

model AiAction {
  id                 String         @id @default(uuid())
  clubId             String         @map("club_id")
  requestedByAi      AiAgent        @map("requested_by_ai")
  actionType         String         @map("action_type") @db.VarChar(100)
  targetModule       String?        @map("target_module") @db.VarChar(100)
  targetEntityType   String?        @map("target_entity_type") @db.VarChar(100)
  targetEntityId     String?        @map("target_entity_id")
  riskLevel          AiActionRisk   @map("risk_level")
  title              String         @db.VarChar(200)
  summary            String?
  requestPayload     Json?          @map("request_payload")
  status             AiActionStatus @default(PENDING_APPROVAL)
  approvalRequired   Boolean        @default(true) @map("approval_required")
  approvalPolicy     Json?          @map("approval_policy")
  approvedBy         String?        @map("approved_by")
  approvedAt         DateTime?      @map("approved_at")
  rejectedBy         String?        @map("rejected_by")
  rejectedAt         DateTime?      @map("rejected_at")
  rejectionReason    String?        @map("rejection_reason")
  executionResult    Json?          @map("execution_result")
  errorMessage       String?        @map("error_message")
  retryCount         Int            @default(0) @map("retry_count")
  executorAgent      AiAgent?       @map("executor_agent")
  executorStartedAt  DateTime?      @map("executor_started_at")
  executorFinishedAt DateTime?      @map("executor_finished_at")
  executionDuration  Int?           @map("execution_duration")
  createdById        String?        @map("created_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  club   Club            @relation(fields: [clubId], references: [id])
  events AiActionEvent[]

  @@index([clubId, status])
  @@index([clubId, requestedByAi])
  @@index([clubId, riskLevel])
  @@map("ai_actions")
}

model AiActionEvent {
  id          String   @id @default(uuid())
  actionId    String   @map("action_id")
  clubId      String   @map("club_id")
  type        String   @db.VarChar(40)
  message     String?
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  action AiAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("ai_action_events")
}

// ============================================================
// HERMES WORKFLOW ENGINE (Epic 5) — rule-based workflow orchestration.
// Operational actions ALWAYS flow through AI Action Center (never executed directly).
// ============================================================
enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowRule {
  id             String   @id @default(uuid())
  clubId         String   @map("club_id")
  name           String   @db.VarChar(200)
  triggerType    String   @map("trigger_type") @db.VarChar(60)
  // Phase 1 (dedup rule trùng): phạm vi nghiệp vụ của rule. NULL = rule club-wide (canonical
  // duy nhất cho clubId+triggerType). Biến thể theo phạm vi khác (vd fundPeriod/session) dùng
  // scopeKey khác. Khoá chống trùng khi tạo từ template: clubId + triggerType + scopeKey.
  scopeKey       String?  @map("scope_key") @db.VarChar(120)
  conditionsJson Json?    @map("conditions_json")
  actionsJson    Json?    @map("actions_json")
  enabled        Boolean  @default(true)
  priority       Int      @default(100)
  // Epic 9: lịch tự động — MANUAL (mặc định, không tự chạy) | DAILY | WEEKLY | MONTHLY.
  scheduleType   String   @default("MANUAL") @map("schedule_type") @db.VarChar(20)
  createdById    String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  club Club          @relation(fields: [clubId], references: [id])
  runs WorkflowRun[]

  @@index([clubId, enabled])
  @@index([clubId, triggerType])
  @@index([clubId, triggerType, scopeKey])
  @@map("workflow_rules")
}

// ============================================================
// HERMES NOTIFICATION RUNTIME (Epic 8) — job gửi thông báo qua adapter
// quanh hạ tầng có sẵn (Notification/Email/Telegram). payloadJson CHỈ nội bộ.
// ============================================================
enum NotificationJobStatus {
  DRY_RUN // channel chưa sẵn sàng/chưa an toàn — ghi nhận, KHÔNG gửi thật
  READY // đã gửi qua hạ tầng có sẵn
  FAILED // adapter lỗi — errorMessage generic
}

model NotificationJob {
  id             String                @id @default(uuid())
  clubId         String                @map("club_id")
  channel        NotificationChannel
  targetType     String                @map("target_type") @db.VarChar(30)
  targetId       String?               @map("target_id")
  title          String                @db.VarChar(200)
  bodySummary    String?               @map("body_summary") @db.VarChar(300)
  payloadJson    Json?                 @map("payload_json")
  status         NotificationJobStatus
  idempotencyKey String?               @map("idempotency_key") @db.VarChar(120)
  errorMessage   String?               @map("error_message")
  aiActionId     String?               @map("ai_action_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  sentAt         DateTime?             @map("sent_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, channel, idempotencyKey])
  @@index([clubId, status])
  @@index([clubId, createdAt])
  @@map("notification_jobs")
}

model WorkflowRun {
  id             String            @id @default(uuid())
  clubId         String            @map("club_id")
  workflowRuleId String?           @map("workflow_rule_id")
  triggerType    String            @map("trigger_type") @db.VarChar(60)
  status         WorkflowRunStatus @default(PENDING)
  contextJson    Json?             @map("context_json")
  resultJson     Json?             @map("result_json")
  errorMessage   String?           @map("error_message")
  // Chống dispatch trùng (Epic 6): NULL cho test-trigger thủ công; unique per (club, rule, key).
  idempotencyKey String?           @map("idempotency_key") @db.VarChar(120)
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  club Club          @relation(fields: [clubId], references: [id])
  rule WorkflowRule? @relation(fields: [workflowRuleId], references: [id], onDelete: SetNull)

  @@unique([clubId, workflowRuleId, idempotencyKey])
  @@index([clubId, status])
  @@index([workflowRuleId])
  @@map("workflow_runs")
}

/// Club Memory v2.2 — persist thay In-Memory Repository (trước đây mất dữ liệu
/// mỗi lần backend restart/deploy). Nguồn tri thức chung của club: Maika đọc qua
/// OrganizationContextManager (lọc PII/finance trước khi vào AI context).
model ClubMemory {
  id        String         @id @default(uuid())
  clubId    String         @map("club_id")
  type      ClubMemoryType
  title     String?        @db.VarChar(300)
  content   String
  tags      String[]       @default([])
  metadata  Json           @default("{}")
  createdBy String?        @map("created_by")
  updatedBy String?        @map("updated_by")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id])

  @@index([clubId])
  @@index([clubId, type])
  @@map("club_memories")
}

enum ClubMemoryType {
  FACT
  RULE
  PREFERENCE
  POLICY
  KNOWLEDGE
  OPERATIONAL_NOTE
}

// ============================================================
// MEMBER SCORING (Chấm điểm thành viên động — Phase 1)
// ============================================================
enum ScoringCategory {
  PARTICIPATION
  CONDUCT
  CONTRIBUTION
  DISCIPLINE
  FINANCE
  BONUS
}

enum ScoringSource {
  AUTO_ATTENDANCE
  AUTO_FINANCE
  MANUAL
}

/// Quy tắc điểm CÓ CẤU TRÚC per-club (seed từ template, CLB sửa qua UI — phần "động").
model ScoringRule {
  id        String          @id @default(uuid())
  clubId    String          @map("club_id")
  // Khóa hệ thống BẤT BIẾN cho rule template (auto-scoring khớp qua đây, không phụ thuộc
  // label CLB có thể sửa). Rule do CLB tự tạo = null. Unique theo (clubId, systemKey).
  systemKey String?         @map("system_key") @db.VarChar(60)
  category  ScoringCategory
  label     String          @db.VarChar(200)
  delta     Int
  source    ScoringSource   @default(MANUAL)
  active    Boolean         @default(true)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  club   Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  events MemberScoreEvent[]

  @@unique([clubId, systemKey])
  @@index([clubId, category])
  @@map("scoring_rules")
}

/// Sự kiện cộng/trừ điểm của 1 thành viên trong 1 tháng.
model MemberScoreEvent {
  id          String          @id @default(uuid())
  clubId      String          @map("club_id")
  memberId    String          @map("member_id")
  ruleId      String?         @map("rule_id")
  category    ScoringCategory
  label       String          @db.VarChar(200)
  delta       Int
  source      ScoringSource
  periodMonth String          @map("period_month") @db.VarChar(7) // YYYY-MM
  note        String?
  refId       String?         @map("ref_id") // id buổi/khoản đóng để chống cộng trùng auto
  createdById String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  club   Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rule   ScoringRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  // Chống cộng trùng event auto (refId set). Manual có refId=null → Postgres coi NULL khác nhau → cho phép lặp.
  @@unique([memberId, source, periodMonth, refId], name: "uniq_auto_score_event")
  @@index([clubId, periodMonth])
  @@index([memberId, periodMonth])
  @@map("member_score_events")
}

/// Snapshot chốt điểm cuối tháng (tháng hiện tại tính live; tháng đã chốt đọc snapshot).
model MemberScoreSnapshot {
  id             String   @id @default(uuid())
  clubId         String   @map("club_id")
  memberId       String   @map("member_id")
  periodMonth    String   @map("period_month") @db.VarChar(7)
  totalScore     Int      @map("total_score")
  classification String   @db.VarChar(40)
  finalizedById  String?  @map("finalized_by")
  finalizedAt    DateTime @default(now()) @map("finalized_at")

  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodMonth])
  @@index([clubId, periodMonth])
  @@map("member_score_snapshots")
}

/// Insight/kết quả phân tích của Maika (daily brief, weekly report, anomaly, health score) —
/// LƯU lại để AIDO khoe "Maika phân tích được VIỆC GÌ" (trước đây chỉ chạy runtime, không lưu).
model MaikaInsight {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  type      String   @db.VarChar(30) // daily_brief | weekly_report | anomaly | health_score
  title     String   @db.VarChar(200)
  content   String
  severity  String?  @db.VarChar(20) // info | attention | warning
  score     Int? // điểm sức khỏe nếu có
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([clubId, type])
  @@map("maika_insights")
}

/// Hội thoại Q&A của Lisa (member hỏi — Lisa trả lời) — LƯU lại để AIDO đếm "Lisa trả lời bao
/// nhiêu lượt" + xem gần đây (trước đây hội thoại in-memory volatile, không lưu).
model LisaMessage {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  memberId  String?  @map("member_id")
  question  String
  answer    String
  createdAt DateTime @default(now()) @map("created_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@map("lisa_messages")
}
